---
import { Picture } from "astro:assets";
import {
  ArrowRightIcon as ArrowRight,
  EnvelopeIcon as Envelope,
  FacebookLogoIcon as FacebookLogo,
  ForkKnifeIcon as ForkKnife,
  MapPinIcon as MapPin,
  MopedIcon as Moped,
  PhoneIcon as Phone,
} from "@phosphor-icons/react/dist/ssr";
import BaseLayout from "@/layouts/BaseLayout.astro";
import OpenStatus from "@/components/OpenStatus";
import MapReveal from "@/components/MapReveal";
import { business, formatAddress, weeklyHours } from "@/data/business";
import { formatHours } from "@/lib/hours";
import exteriorImage from "../../images/vault-223-exterior.jpeg";
import doorImage from "../../images/vault-223-door.webp";
import interiorImage from "../../images/restaurant.jpg";
---

<BaseLayout
  title="Visit & Order"
  description="Find Vault 223 at 223 N Main Street in downtown Kokomo. View regular hours, get directions, call the café, or order online."
>
  <header class="visit-hero">
    <div class="visit-hero-image">
      <Picture
        src={exteriorImage}
        formats={["avif", "webp"]}
        widths={[640, 960, 1360]}
        sizes="100vw"
        quality={88}
        alt="Vault 223 storefront at 223 North Main Street in downtown Kokomo"
        loading="eager"
        fetchpriority="high"
      />
      <div class="visit-hero-shade"></div>
    </div>
    <div class="page-shell visit-hero-copy">
      <p class="eyebrow">Downtown Kokomo</p>
      <h1>Find the door marked 223.</h1>
      <p>{formatAddress()}</p>
      <div class="button-row">
        <a class="brass-button" href={business.directions} target="_blank" rel="noreferrer"><MapPin size={20} weight="fill" /> Get Directions</a>
        <button class="outline-button" type="button" data-order-trigger data-mobile-order-sentinel><ForkKnife size={20} /> Order Online</button>
      </div>
    </div>
  </header>

  <section class="visit-practical section-space">
    <div class="page-shell practical-grid">
      <div class="practical-main">
        <p class="eyebrow">Come on in</p>
        <h2>Everything you need before you head downtown.</h2>
        <OpenStatus client:load />
        <div class="contact-action-grid">
          <a href={business.directions} target="_blank" rel="noreferrer"><MapPin size={25} weight="fill" /><span><small>Address</small><strong>{business.address.street}<br />{business.address.city}, {business.address.state} {business.address.postalCode}</strong></span><ArrowRight size={19} /></a>
          <a href={business.phoneHref}><Phone size={25} weight="fill" /><span><small>Call the café</small><strong>{business.phone}</strong></span><ArrowRight size={19} /></a>
          <a href={`mailto:${business.email}`}><Envelope size={25} weight="fill" /><span><small>Email</small><strong>{business.email}</strong></span><ArrowRight size={19} /></a>
          <a href={business.facebook} target="_blank" rel="noreferrer"><FacebookLogo size={25} weight="fill" /><span><small>Fresh updates</small><strong>Follow on Facebook</strong></span><ArrowRight size={19} /></a>
        </div>
      </div>
      <aside class="hours-card">
        <div class="hours-card-top"><span>223</span><p>Regular Hours</p></div>
        <dl>
          {weeklyHours.map((entry) => (
            <div><dt>{entry.label}</dt><dd>{formatHours(entry)}</dd></div>
          ))}
        </dl>
        <p class="hours-note">For unexpected schedule changes, check our Facebook page before making a special trip.</p>
      </aside>
    </div>
  </section>

  <section class="map-section page-shell">
    <MapReveal client:visible />
  </section>

  <section class="inside-section section-space">
    <div class="page-shell inside-grid">
      <div class="inside-copy">
        <p class="eyebrow">Inside the vault</p>
        <h2>A café with a story in the walls.</h2>
        <p class="lead">Vault 223 is built around a real 100-year-old vault inside a historic downtown building.</p>
        <p>Settle into the lounge, meet a friend over coffee, or grab breakfast and lunch to take with you. The space is comfortable, unhurried, and unmistakably Kokomo.</p>
        <a class="text-link" href="/menu/">See what we’re serving <ArrowRight size={19} /></a>
      </div>
      <div class="inside-images">
        <figure class="interior-photo">
          <Picture src={interiorImage} formats={["avif", "webp"]} widths={[720, 1100, 1440]} sizes="(min-width: 900px) 53vw, 100vw" quality={88} alt="The Vault 223 interior with lounge seating and coffee counter" loading="lazy" />
          <figcaption>Stay awhile</figcaption>
        </figure>
        <figure class="door-photo">
          <Picture src={doorImage} formats={["webp"]} widths={[360, 520, 574]} sizes="(min-width: 900px) 20vw, 42vw" quality={88} alt="The Vault 223 entrance door with logo and hours" loading="lazy" />
          <figcaption>Main Street entrance</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="order-visit section-space">
    <div class="page-shell order-visit-inner">
      <div>
        <p class="eyebrow">Take Vault 223 with you</p>
        <h2>Delivery and takeout, a tap away.</h2>
        <p>Choose DoorDash or Uber Eats and complete your order with the provider you already use.</p>
      </div>
      <div class="order-actions">
        <div class="delivery-graphic" aria-hidden="true">
          <div class="delivery-route"></div>
          <span class="delivery-origin">223</span>
          <span class="delivery-scooter"><Moped size={112} weight="duotone" /></span>
          <span class="delivery-destination"><MapPin size={25} weight="fill" /></span>
          <span class="delivery-status">Heading your way</span>
        </div>
        <button class="brass-button" type="button" data-order-trigger>Choose a provider <ArrowRight size={20} /></button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .visit-hero { position: relative; min-height: min(760px, calc(100svh - var(--header-height))); background: var(--ink); color: var(--cream); }
  .visit-hero-image { position: absolute; inset: 0; }
  .visit-hero-image :global(picture), .visit-hero-image :global(img) { width: 100%; height: 100%; }
  .visit-hero-image :global(img) { object-fit: cover; object-position: 64% 50%; }
  .visit-hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(17 16 14 / .26), rgb(17 16 14 / .72) 72%, rgb(17 16 14 / .9)); }
  .visit-hero-copy { position: relative; z-index: 1; display: flex; min-height: min(760px, calc(100svh - var(--header-height))); flex-direction: column; justify-content: flex-end; padding-block: 64px; }
  .visit-hero-copy h1 { max-width: 900px; margin-bottom: 18px; text-shadow: 0 3px 24px rgb(0 0 0 / .35); }
  .visit-hero-copy > p:not(.eyebrow) { margin-bottom: 26px; font-family: "IBM Plex Mono", monospace; font-size: .88rem; }
  .visit-hero-copy .outline-button { border-color: rgb(246 235 215 / .52); color: var(--cream); }
  .practical-grid { display: grid; gap: 48px; }
  .practical-main h2 { max-width: 820px; margin-bottom: 30px; }
  .practical-main :global(.open-status) { width: fit-content; margin-bottom: 32px; border-left: 4px solid var(--brass); background: var(--paper); padding: 14px 18px; }
  .contact-action-grid { display: grid; border-top: 1px solid var(--line); }
  .contact-action-grid > a { display: grid; min-height: 86px; grid-template-columns: auto 1fr auto; align-items: center; gap: 14px; border-bottom: 1px solid var(--line); padding: 14px 4px; }
  .contact-action-grid > a > :global(svg:first-child) { color: var(--brass); }
  .contact-action-grid small, .contact-action-grid strong { display: block; }
  .contact-action-grid small { margin-bottom: 3px; color: var(--muted); font-family: "IBM Plex Mono", monospace; font-size: .58rem; letter-spacing: .08em; text-transform: uppercase; }
  .contact-action-grid strong { overflow-wrap: anywhere; font-size: .9rem; }
  .hours-card { align-self: start; border: 1px solid var(--ink); background: var(--paper); box-shadow: 12px 12px 0 var(--brass); }
  .hours-card-top { display: flex; min-height: 90px; align-items: center; gap: 18px; border-bottom: 2px solid var(--ink); background: var(--ink); padding: 16px; color: var(--cream); }
  .hours-card-top span { display: grid; width: 56px; height: 56px; flex: 0 0 auto; place-items: center; border: 1px solid var(--brass); border-radius: 50%; color: var(--brass); font-family: "Bitter Variable", serif; font-weight: 800; }
  .hours-card-top p { margin: 0; font-family: "Bitter Variable", serif; font-size: 1.35rem; font-weight: 800; }
  .hours-card dl { margin: 0; padding: 10px 16px; }
  .hours-card dl div { display: flex; min-height: 42px; align-items: center; justify-content: space-between; gap: 12px; border-bottom: 1px solid var(--line); }
  .hours-card dt { color: var(--muted); }
  .hours-card dd { margin: 0; font-family: "IBM Plex Mono", monospace; font-size: .74rem; }
  .hours-note { margin: 0; padding: 16px; color: var(--muted); font-size: .74rem; }
  .map-section { margin-bottom: clamp(72px, 10vw, 140px); box-shadow: var(--shadow); }
  .inside-section { background: var(--slate); color: var(--cream); }
  .inside-grid { display: grid; gap: 52px; }
  .inside-copy { align-self: center; }
  .inside-copy h2 { margin-bottom: 22px; }
  .inside-copy .lead { color: rgb(246 235 215 / .82); }
  .inside-copy > p:not(.eyebrow):not(.lead) { color: rgb(246 235 215 / .62); }
  .inside-images { position: relative; min-height: 520px; }
  .inside-images figure { position: absolute; margin: 0; box-shadow: 0 20px 60px rgb(0 0 0 / .34); }
  .inside-images :global(picture), .inside-images :global(img) { width: 100%; height: 100%; }
  .inside-images :global(img) { object-fit: cover; }
  .inside-images figcaption { position: absolute; right: 0; bottom: 0; background: var(--ink); padding: 8px 11px; color: var(--brass); font-family: "IBM Plex Mono", monospace; font-size: .62rem; text-transform: uppercase; }
  .interior-photo { top: 0; left: 0; width: 90%; height: 330px; }
  .door-photo { right: 0; bottom: 0; width: 48%; height: 310px; border: 5px solid var(--cream); transform: rotate(2deg); }
  .order-visit { position: relative; overflow: hidden; background: var(--espresso); color: var(--cream); }
  .order-visit-inner { position: relative; z-index: 1; display: grid; gap: 30px; align-items: end; }
  .order-visit h2 { max-width: 800px; margin-bottom: 16px; }
  .order-visit p:not(.eyebrow) { max-width: 570px; margin: 0; color: rgb(246 235 215 / .66); }
  .order-actions { display: grid; justify-items: center; gap: 12px; }
  .order-actions .brass-button { width: min(100%, 330px); }
  .delivery-graphic { position: relative; width: min(100%, 330px); height: 188px; color: var(--brass); }
  .delivery-route { position: absolute; right: 24px; bottom: 45px; left: 24px; height: 74px; border-bottom: 2px dashed rgb(211 154 50 / .48); border-radius: 0 0 50% 50%; transform: rotate(-2deg); }
  .delivery-origin, .delivery-destination { position: absolute; bottom: 31px; display: grid; width: 48px; height: 48px; place-items: center; border: 1px solid rgb(211 154 50 / .58); border-radius: 50%; background: var(--espresso); box-shadow: 0 0 0 8px var(--espresso); }
  .delivery-origin { left: 0; font-family: "IBM Plex Mono", monospace; font-size: .72rem; font-weight: 600; }
  .delivery-destination { right: 0; }
  .delivery-scooter { position: absolute; top: 22px; left: 50%; filter: drop-shadow(0 8px 12px rgb(0 0 0 / .2)); transform: translateX(-45%); }
  .delivery-scooter::before, .delivery-scooter::after { position: absolute; top: 42px; right: calc(100% + 2px); height: 1px; background: rgb(211 154 50 / .52); content: ""; }
  .delivery-scooter::before { width: 42px; }
  .delivery-scooter::after { top: 54px; width: 26px; }
  .delivery-status { position: absolute; right: 0; bottom: 0; left: 0; font-family: "IBM Plex Mono", monospace; font-size: .58rem; font-weight: 600; letter-spacing: .15em; text-align: center; text-transform: uppercase; }
  @media (hover: hover) { .contact-action-grid > a:hover { background: rgb(255 250 240 / .6); } }
  @media (min-width: 700px) {
    .contact-action-grid { grid-template-columns: repeat(2, 1fr); }
    .contact-action-grid > a:nth-child(odd) { border-right: 1px solid var(--line); padding-right: 18px; }
    .contact-action-grid > a:nth-child(even) { padding-left: 18px; }
    .inside-images { min-height: 650px; }
    .interior-photo { width: 86%; height: 450px; }
    .door-photo { width: 40%; height: 420px; }
    .order-visit-inner { grid-template-columns: minmax(0, 1fr) minmax(300px, 380px); align-items: center; }
    .delivery-graphic { width: min(100%, 360px); height: 205px; }
    .order-actions .brass-button { width: min(100%, 350px); }
  }
  @media (min-width: 960px) {
    .visit-hero-shade { background: linear-gradient(90deg, rgb(17 16 14 / .82) 0, rgb(17 16 14 / .5) 47%, rgb(17 16 14 / .05) 78%); }
    .visit-hero-copy { justify-content: center; }
    .visit-hero-copy h1 { max-width: 750px; font-size: clamp(4.8rem, 6vw, 7.2rem); }
    .practical-grid { grid-template-columns: minmax(0, 1.35fr) minmax(320px, .65fr); gap: clamp(70px, 8vw, 120px); }
    .inside-grid { grid-template-columns: .78fr 1.22fr; gap: clamp(70px, 8vw, 130px); }
    .inside-images { min-height: 720px; }
    .interior-photo { width: 87%; height: 520px; }
    .door-photo { width: 37%; height: 480px; }
  }
</style>
