---
import { Picture } from "astro:assets";
import {
  ArrowRightIcon as ArrowRight,
  ForkKnifeIcon as ForkKnife,
  MapPinIcon as MapPin,
  PhoneIcon as Phone,
  SealCheckIcon as SealCheck,
} from "@phosphor-icons/react/dist/ssr";
import BaseLayout from "@/layouts/BaseLayout.astro";
import OpenStatus from "@/components/OpenStatus";
import { business, formatAddress } from "@/data/business";
import heroImage from "../../images/Vault223_Hero.jpg";
import breakfastImage from "../../images/Vault223_BreakfastCroissant.jpg";
import coffeeImage from "../../images/Vault223_ColdBrew.jpg";
import paniniImage from "../../images/Vault223_ChickenPestoPanini.jpg";
import crepeImage from "../../images/Vault223_StrawberryCheesecakeCrepe.jpg";
import pizzaImage from "../../images/Vault223_OurFamousVaultedPizza.jpg";
import saladImage from "../../images/Vault223_SummerBreezeSalad.jpg";
import storyImage from "../../images/IMG_8125.jpeg";
import exteriorImage from "../../images/vault-223-exterior.jpeg";

const categories = [
  { title: "Breakfast", note: "Served all day", href: "/menu/#breakfast", image: breakfastImage, alt: "Vaulted breakfast croissant with ham, egg, and cheese" },
  { title: "Coffee", note: "Hot, iced & cold brew", href: "/menu/#coffee-tea", image: coffeeImage, alt: "Vault 223 cold brew on a branded coaster" },
  { title: "Lunch", note: "Hoagies, paninis & more", href: "/menu/#lunch", image: paniniImage, alt: "Grilled chicken pesto panini" },
  { title: "Crepes", note: "Sweet & savory", href: "/menu/#sweet-crepes", image: crepeImage, alt: "Fresh strawberry cheesecake crepe" },
  { title: "Pizza", note: "Crispy artisan flatbread", href: "/menu/#flatbread", image: pizzaImage, alt: "Vaulted flatbread pizza with greens and banana peppers" },
  { title: "Fresh", note: "Salads & smoothies", href: "/menu/#salads", image: saladImage, alt: "Strawberry salad with mixed greens" },
];
---

<BaseLayout
  title="Vault 223"
  description="Coffee, breakfast, lunch, crepes, and flatbread inside a historic downtown Kokomo vault. Visit Vault 223 at 223 N Main Street."
>
  <section class="home-hero">
    <div class="hero-main">
      <div class="hero-copy page-shell">
        <div class="hero-copy-inner">
          <div class="hero-brand-mark">
            <img src="/vault-223-logo.png" width="512" height="512" alt="Vault 223 — Fueling Big Dreams" />
          </div>
          <h1>Coffee, food & a century of character.</h1>
          <p class="hero-lead">Breakfast, lunch, crepes, pizza, and crafted drinks—served inside Vault 223.</p>
          <div class="button-row hero-actions">
            <button class="brass-button" type="button" data-order-trigger data-mobile-order-sentinel>
              <ForkKnife size={20} weight="bold" aria-hidden="true" /> Order Online
            </button>
            <a class="outline-button" href="/menu/">View Menu <ArrowRight size={20} aria-hidden="true" /></a>
          </div>
        </div>
      </div>
      <div class="hero-media">
        <Picture
          src={heroImage}
          formats={["avif", "webp"]}
          widths={[640, 960, 1280, 1920]}
          sizes="(min-width: 960px) 56vw, 100vw"
          quality={88}
          alt="An overhead spread of Vault 223 pizza, salads, breakfast, sandwiches, crepes, drinks, and branded coasters"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
    <div class="hero-info-bar">
      <div class="page-shell hero-info-inner">
        <a class="hero-location" href={business.directions} target="_blank" rel="noreferrer">
          <MapPin size={19} weight="fill" aria-hidden="true" />
          <span>223 N Main St · Kokomo</span>
        </a>
        <div class="hero-basic-hours" aria-label="Regular hours">
          <span>Tue–Fri <strong>7 AM–5 PM</strong></span>
          <span>Sat <strong>10 AM–4 PM</strong></span>
        </div>
        <OpenStatus client:load />
        <a class="hero-visit-link" href="/visit/">Visit <ArrowRight size={17} aria-hidden="true" /></a>
      </div>
    </div>
  </section>

  <section class="category-section section-space">
    <div class="page-shell section-intro">
      <div>
        <p class="eyebrow">Made for your day</p>
        <h2>Morning fuel.<br />Lunch worth lingering over.</h2>
      </div>
      <p>From a first coffee on Main Street to a crepe after lunch, the menu is built for quick stops and unhurried catch-ups alike.</p>
    </div>
    <div class="category-rail" aria-label="Menu categories">
      {categories.map((category, index) => (
        <a class="category-card" href={category.href}>
          <div class="category-image">
            <Picture
              src={category.image}
              formats={["avif", "webp"]}
              widths={[480, 720, 960]}
              sizes="(min-width: 960px) 28vw, 74vw"
              quality={86}
              alt={category.alt}
              loading="lazy"
            />
            <span class="category-number">0{index + 1}</span>
          </div>
          <div class="category-card-copy">
            <div><h3>{category.title}</h3><p>{category.note}</p></div>
            <ArrowRight size={23} aria-hidden="true" />
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="story-section section-space">
    <div class="page-shell story-grid">
      <div class="story-image-frame">
        <Picture
          src={storyImage}
          formats={["avif", "webp"]}
          widths={[640, 960, 1280, 1800]}
          sizes="(min-width: 960px) 52vw, 100vw"
          quality={88}
          alt="A branded iced drink on the counter with Vault 223 café seating in the background"
          loading="lazy"
        />
        <div class="story-seal"><SealCheck size={24} weight="fill" /><span>Locally<br />owned</span></div>
      </div>
      <div class="story-copy">
        <p class="eyebrow">Inside the vault</p>
        <h2>A downtown café built around the real thing.</h2>
        <p class="lead">Vault 223 lives inside a historic building and around a real 100-year-old vault—a little piece of Kokomo character that makes every coffee run feel like a destination.</p>
        <p>Come for a handcrafted latte or a quick breakfast. Stay for the comfortable seats, the conversation, and lunch made with care.</p>
        <a class="text-link" href="/visit/">Plan your visit <ArrowRight size={19} aria-hidden="true" /></a>
      </div>
    </div>
  </section>

  <section class="signature-section section-space">
    <div class="signature-heading page-shell">
      <p class="eyebrow">House signatures</p>
      <h2>Fresh, colorful,<br />unmistakably Vaulted.</h2>
    </div>
    <div class="signature-grid page-shell">
      <figure class="signature-large">
        <Picture src={pizzaImage} formats={["avif", "webp"]} widths={[640, 960, 1400, 1800]} sizes="(min-width: 900px) 58vw, 100vw" quality={88} alt="Vaulted flatbread pizza" loading="lazy" />
        <figcaption><span>01</span><strong>Our Famous Vaulted Pizza</strong></figcaption>
      </figure>
      <figure>
        <Picture src={saladImage} formats={["avif", "webp"]} widths={[480, 720, 1000]} sizes="(min-width: 900px) 34vw, 100vw" quality={88} alt="Vaulted strawberry salad" loading="lazy" />
        <figcaption><span>02</span><strong>Vaulted Strawberry Salad</strong></figcaption>
      </figure>
      <figure>
        <Picture src={coffeeImage} formats={["avif", "webp"]} widths={[480, 720, 1000]} sizes="(min-width: 900px) 34vw, 100vw" quality={88} alt="Cold brew on a Vault 223 coaster" loading="lazy" />
        <figcaption><span>03</span><strong>Cold Brew, Your Way</strong></figcaption>
      </figure>
    </div>
    <div class="page-shell signature-action"><a class="dark-button" href="/menu/">See the full menu <ArrowRight size={20} /></a></div>
  </section>

  <section class="visit-preview">
    <div class="visit-image">
      <Picture
        src={exteriorImage}
        formats={["avif", "webp"]}
        widths={[680, 1020, 1360]}
        sizes="(min-width: 900px) 55vw, 100vw"
        quality={88}
        alt="Vault 223 storefront at 223 North Main Street in downtown Kokomo"
        loading="lazy"
      />
    </div>
    <div class="visit-copy">
      <p class="eyebrow">Find the door marked 223</p>
      <h2>Right in the heart of downtown.</h2>
      <p class="visit-address"><MapPin size={24} weight="fill" /> {formatAddress()}</p>
      <dl class="visit-hours">
        <div><dt>Tuesday–Friday</dt><dd>7 AM–5 PM</dd></div>
        <div><dt>Saturday</dt><dd>10 AM–4 PM</dd></div>
        <div><dt>Sunday–Monday</dt><dd>Closed</dd></div>
      </dl>
      <div class="button-row">
        <a class="brass-button" href={business.directions} target="_blank" rel="noreferrer"><MapPin size={20} /> Get Directions</a>
        <a class="outline-button" href={business.phoneHref}><Phone size={20} /> Call Us</a>
      </div>
    </div>
  </section>

  <section class="final-cta section-space">
    <div class="page-shell final-cta-inner">
      <div>
        <p class="eyebrow">Ready when you are</p>
        <h2>Your next favorite is behind the vault door.</h2>
      </div>
      <div class="final-cta-actions">
        <button class="brass-button" type="button" data-order-trigger>Order Online <ArrowRight size={20} /></button>
        <a class="text-link" href={business.facebook} target="_blank" rel="noreferrer">Follow us on Facebook</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero { position: relative; overflow: hidden; background: var(--ink); color: var(--cream); }
  .hero-main { position: relative; z-index: 1; }
  .hero-copy { position: relative; display: grid; min-height: 410px; align-items: center; padding-block: clamp(48px, 8vw, 78px); }
  .hero-copy-inner { position: relative; z-index: 4; width: 100%; max-width: 650px; }
  .hero-brand-mark { position: relative; width: min(318px, 100%); aspect-ratio: 1; margin: 0 auto 18px; filter: drop-shadow(0 12px 28px rgb(211 154 50 / .16)); overflow: hidden; }
  .hero-brand-mark img { width: 100%; height: 100%; object-fit: contain; }
  .hero-brand-mark::after { position: absolute; inset: 0; background: linear-gradient(108deg, transparent 48.5%, rgb(255 244 205 / .14) 49.35%, rgb(255 232 150 / .78) 50%, rgb(240 188 88 / .16) 50.65%, transparent 51.5%); background-position: 150% 0; background-repeat: no-repeat; background-size: 260% 100%; clip-path: inset(41.5% 12.5% 39.5%); content: ""; mask: url("/vault-223-logo.png") center / contain no-repeat; mix-blend-mode: screen; opacity: .58; pointer-events: none; }
  .hero-copy h1 { max-width: 720px; margin-bottom: 18px; }
  .hero-lead { max-width: 540px; margin-bottom: 25px; color: rgb(246 235 215 / .76); font-size: clamp(1.02rem, 2vw, 1.26rem); }
  .hero-actions .outline-button { border-color: rgb(246 235 215 / .45); color: var(--cream); }
  .hero-media { position: relative; height: clamp(310px, 76vw, 440px); overflow: hidden; }
  .hero-media :global(picture), .hero-media :global(img) { width: 100%; height: 100%; }
  .hero-media :global(img) { object-fit: cover; object-position: 50% 48%; }
  .hero-info-bar { position: relative; z-index: 2; border-block: 1px solid var(--line); background: var(--paper); color: var(--ink); }
  .hero-info-inner { position: relative; z-index: 4; display: grid; min-height: 114px; grid-template-columns: 1fr auto; align-items: center; gap: 8px 20px; padding-block: 12px; }
  .hero-location, .hero-visit-link { display: inline-flex; min-height: 44px; align-items: center; gap: 8px; font-weight: 700; }
  .hero-location { max-width: calc(100% - 80px); }
  .hero-location :global(svg) { flex: 0 0 auto; color: var(--brass); }
  .hero-basic-hours { display: flex; grid-column: 1 / -1; flex-wrap: wrap; gap: 5px 16px; font-family: "IBM Plex Mono", monospace; font-size: .68rem; }
  .hero-basic-hours span { white-space: nowrap; }
  .hero-basic-hours strong { color: var(--espresso); }
  .hero-info-inner :global(.open-status) { grid-column: 1 / -1; }
  .hero-visit-link { grid-column: 2; grid-row: 1; }
  .section-intro { display: grid; gap: 24px; margin-bottom: 42px; }
  .section-intro h2 { margin: 0; }
  .section-intro > p { max-width: 520px; margin: 0; align-self: end; color: var(--muted); font-size: 1.05rem; }
  .category-rail { display: flex; width: 100%; gap: 14px; overflow-x: auto; padding: 0 max(16px, calc((100vw - 1240px) / 2)) 18px; scroll-padding-inline: 16px; scroll-snap-type: x mandatory; scrollbar-width: thin; }
  .category-card { width: min(76vw, 330px); flex: 0 0 auto; scroll-snap-align: start; background: var(--paper); box-shadow: 0 10px 36px rgb(17 16 14 / .08); }
  .category-image { position: relative; aspect-ratio: 4 / 3; overflow: hidden; }
  .category-image :global(picture), .category-image :global(img) { width: 100%; height: 100%; }
  .category-image :global(img) { object-fit: cover; transition: transform 450ms ease; }
  .category-number { position: absolute; top: 12px; left: 12px; display: grid; width: 36px; height: 36px; place-items: center; background: var(--ink); color: var(--brass); font-family: "IBM Plex Mono", monospace; font-size: .68rem; }
  .category-card-copy { display: flex; min-height: 110px; align-items: center; justify-content: space-between; gap: 18px; padding: 18px; }
  .category-card h3 { margin-bottom: 5px; font-size: 1.45rem; }
  .category-card p { margin: 0; color: var(--muted); font-size: .84rem; }
  .story-section { background: var(--slate); color: var(--cream); }
  .story-grid { display: grid; gap: 54px; }
  .story-image-frame { position: relative; aspect-ratio: 4 / 5; overflow: hidden; }
  .story-image-frame :global(picture), .story-image-frame :global(img) { width: 100%; height: 100%; }
  .story-image-frame :global(img) { object-fit: cover; object-position: 50% 47%; }
  .story-seal { position: absolute; right: -8px; bottom: -28px; display: flex; width: 104px; height: 104px; align-items: center; justify-content: center; gap: 6px; border-radius: 50%; background: var(--brass); color: var(--ink); font-family: "IBM Plex Mono", monospace; font-size: .64rem; font-weight: 600; line-height: 1.2; text-transform: uppercase; }
  .story-copy { align-self: center; }
  .story-copy h2 { margin-bottom: 24px; }
  .story-copy .lead { color: rgb(246 235 215 / .82); }
  .story-copy > p:not(.eyebrow):not(.lead) { max-width: 56ch; color: rgb(246 235 215 / .62); }
  .story-copy .text-link { margin-top: 18px; }
  .signature-section { background: var(--paper); }
  .signature-heading { margin-bottom: 42px; }
  .signature-grid { display: grid; gap: 18px; }
  .signature-grid figure { position: relative; margin: 0; overflow: hidden; background: var(--cream); }
  .signature-grid :global(picture), .signature-grid :global(img) { width: 100%; height: 100%; }
  .signature-grid :global(img) { aspect-ratio: 4 / 3; object-fit: cover; }
  .signature-grid figcaption { display: flex; min-height: 58px; align-items: center; gap: 12px; padding: 12px 14px; background: var(--ink); color: var(--cream); }
  .signature-grid figcaption span { color: var(--brass); font-family: "IBM Plex Mono", monospace; font-size: .66rem; }
  .signature-grid figcaption strong { font-family: "Bitter Variable", serif; }
  .signature-action { display: flex; justify-content: center; margin-top: 32px; }
  .visit-preview { display: grid; background: var(--espresso); color: var(--cream); }
  .visit-image { min-height: 360px; }
  .visit-image :global(picture), .visit-image :global(img) { width: 100%; height: 100%; }
  .visit-image :global(img) { object-fit: cover; object-position: 64% 50%; }
  .visit-copy { padding: clamp(52px, 8vw, 110px) max(20px, calc((100vw - 1240px) / 2)); }
  .visit-copy h2 { margin-bottom: 22px; }
  .visit-address { display: flex; max-width: 440px; align-items: flex-start; gap: 10px; font-size: 1.08rem; font-weight: 700; }
  .visit-address :global(svg) { flex: 0 0 auto; color: var(--brass); }
  .visit-hours { max-width: 500px; margin: 28px 0; border-top: 1px solid rgb(246 235 215 / .22); }
  .visit-hours div { display: flex; min-height: 46px; align-items: center; justify-content: space-between; gap: 16px; border-bottom: 1px solid rgb(246 235 215 / .16); }
  .visit-hours dt { color: rgb(246 235 215 / .65); }
  .visit-hours dd { margin: 0; font-family: "IBM Plex Mono", monospace; font-size: .8rem; }
  .visit-copy .outline-button { border-color: rgb(246 235 215 / .42); }
  .final-cta { position: relative; background: var(--cream); }
  .final-cta::before { position: absolute; top: 0; left: 50%; width: 1px; height: 48px; background: var(--brass); content: ""; }
  .final-cta-inner { display: grid; gap: 34px; align-items: end; }
  .final-cta h2 { max-width: 840px; margin: 0; }
  .final-cta-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 18px; }
  @media (hover: hover) { .category-card:hover .category-image :global(img) { transform: scale(1.035); } }
  @media (min-width: 700px) {
    .hero-info-inner { min-height: 86px; grid-template-columns: minmax(250px, 1.2fr) auto auto; gap: 18px 28px; }
    .hero-basic-hours { grid-column: 2; grid-row: 1; }
    .hero-info-inner :global(.open-status) { grid-column: 3; grid-row: 1; }
    .hero-visit-link { display: none; }
    .section-intro { grid-template-columns: 1.45fr .8fr; }
    .story-grid { grid-template-columns: 1.1fr .9fr; }
    .signature-grid { grid-template-columns: 1.45fr .8fr; grid-template-rows: repeat(2, minmax(260px, 1fr)); }
    .signature-large { grid-row: 1 / 3; }
    .signature-grid :global(img) { aspect-ratio: auto; }
    .final-cta-inner { grid-template-columns: 1fr auto; }
    .final-cta-actions { justify-content: flex-end; }
  }
  @media (min-width: 960px) {
    .hero-main { display: grid; min-height: max(520px, min(690px, calc(100svh - var(--header-height) - 88px))); grid-template-columns: .9fr 1.1fr; }
    .hero-copy { width: auto; min-height: 0; margin: 0; padding-block: clamp(20px, 3.8vh, 42px); padding-right: clamp(36px, 4.5vw, 72px); padding-left: max(32px, calc((100vw - 1320px) / 2)); }
    .hero-copy h1 { margin-bottom: clamp(10px, 1.5vh, 16px); font-size: clamp(2.75rem, min(4.4vw, 7vh), 4.6rem); }
    .hero-brand-mark { width: clamp(150px, min(16vw, 25vh), 240px); margin-bottom: clamp(8px, 1.3vh, 14px); }
    .hero-lead { max-width: 540px; margin-bottom: clamp(14px, 2.2vh, 22px); font-size: clamp(.96rem, min(1.4vw, 2.2vh), 1.12rem); }
    .hero-media { height: auto; min-height: 0; }
    .hero-media :global(picture) { position: absolute; inset: 0; }
    .hero-media :global(img) { object-position: 54% 50%; }
    .hero-info-inner { grid-template-columns: minmax(290px, 1.2fr) minmax(230px, auto) auto auto; }
    .hero-info-inner :global(.open-status) { grid-column: 3; }
    .hero-visit-link { display: inline-flex; grid-column: 4; grid-row: 1; }
    .category-rail { gap: 20px; }
    .category-card { width: 310px; }
    .story-grid { gap: clamp(70px, 8vw, 130px); }
    .visit-preview { grid-template-columns: 1.12fr .88fr; }
    .visit-image { min-height: 660px; }
    .visit-copy { display: grid; align-content: center; padding-right: max(32px, calc((100vw - 1240px) / 2)); padding-left: clamp(54px, 6vw, 96px); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-brand-mark img { animation: vault-mark-settle 650ms cubic-bezier(.2, .8, .2, 1) both; }
    .hero-brand-mark::after { animation: logo-shine 4.8s ease-in-out 1.1s infinite; }
  }
  @keyframes vault-mark-settle {
    from { opacity: 0; transform: scale(.92); }
  }
  @keyframes logo-shine {
    0%, 68% { background-position: 150% 0; }
    88%, 100% { background-position: -50% 0; }
  }
</style>
